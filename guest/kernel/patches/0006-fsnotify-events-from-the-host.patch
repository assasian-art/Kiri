# Header: Kiri shares the Mac's files with its VM over virtiofs, and Apple's
# virtiofs server tells the guest nothing when a file changes on the Mac, so
# inotify watchers in containers (Vite, webpack, nodemon, cargo watch) never
# saw a save made on the Mac. /proc/kiri-fsnotify lets Kiri's guest agent,
# which hears of those changes from the Mac, raise the fsnotify events Linux
# raises for a local change ("M\t/mnt/mac/…" → IN_MODIFY, C/A/D likewise).
# Nothing is written to the files. Only the VM's agent may write (root, in the
# VM's first mount namespace: not a container). A kernel without it simply
# has no such file, and the agent drops the events.
--- a/fs/notify/Makefile
+++ b/fs/notify/Makefile
@@ -5,3 +5,5 @@
 obj-y			+= dnotify/
 obj-y			+= inotify/
 obj-y			+= fanotify/
+
+obj-$(CONFIG_FSNOTIFY)		+= kiri_inject.o
--- /dev/null
+++ b/fs/notify/kiri_inject.c
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * /proc/kiri-fsnotify: changes made outside the VM, raised as fsnotify
+ * events inside it.
+ *
+ * Kiri shares the Mac's files with its VM over virtiofs. Apple's virtiofs
+ * server tells the guest nothing when a file changes on the Mac, so inotify
+ * watchers in the VM (file watchers in containers) never see those changes.
+ * Kiri's guest agent hears of them from the Mac and writes one line per
+ * change here, "OP\tPATH\n", OP being:
+ *
+ *   C  PATH was created         (IN_CREATE on its directory)
+ *   M  PATH was modified        (IN_MODIFY, then IN_CLOSE_WRITE, as a
+ *                               write and close in the VM raise)
+ *   A  PATH's attributes changed (IN_ATTRIB)
+ *   D  PATH was deleted         (IN_DELETE on its directory, IN_DELETE_SELF)
+ *
+ * Only the events are raised: nothing is written to the file. Only the
+ * VM's own agent may write: root, in the VM's first mount namespace, so a
+ * container (its own mount namespace) can't, even as root.
+ */
+#include <linux/dcache.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/fsnotify.h>
+#include <linux/init.h>
+#include <linux/namei.h>
+#include <linux/nsproxy.h>
+#include <linux/sched/task.h>
+#include <linux/proc_fs.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+/* The file was deleted outside: tell the directory, and the file's own
+ * watchers if the VM still has it cached, then drop the stale entry. */
+static int kiri_deleted(struct path *parent, struct qstr *name)
+{
+	struct inode *dir = d_inode(parent->dentry);
+	struct dentry *child = try_lookup_noperm(name, parent->dentry);
+
+	if (IS_ERR(child))
+		return PTR_ERR(child);
+	if (child && d_really_is_positive(child)) {
+		struct inode *inode = d_inode(child);
+
+		ihold(inode);
+		fsnotify_delete(dir, inode, child);
+		fsnotify_inode(inode, FS_DELETE_SELF);
+		if (!d_mountpoint(child))
+			d_invalidate(child);
+		iput(inode);
+	} else {
+		fsnotify_name(FS_DELETE, dir, FSNOTIFY_EVENT_INODE, dir, name, 0);
+	}
+	dput(child);
+	return 0;
+}
+
+static int kiri_event(char op, char *path)
+{
+	char *slash = strrchr(path, '/');
+	struct path parent, target;
+	struct dentry *dparent;
+	struct qstr name;
+	int err;
+
+	if (path[0] != '/' || !slash || !slash[1])
+		return -EINVAL;
+	*slash = '\0';
+	err = kern_path(path[0] ? path : "/", LOOKUP_FOLLOW | LOOKUP_DIRECTORY, &parent);
+	*slash = '/';
+	if (err)
+		return err;
+	name = (struct qstr)QSTR_INIT(slash + 1, strlen(slash + 1));
+
+	if (op == 'D') {
+		err = kiri_deleted(&parent, &name);
+		path_put(&parent);
+		return err;
+	}
+	path_put(&parent);
+
+	err = kern_path(path, 0, &target);
+	if (err)
+		return err;
+	dparent = dget_parent(target.dentry);
+	switch (op) {
+	case 'C':
+		if (d_is_dir(target.dentry))
+			fsnotify_mkdir(d_inode(dparent), target.dentry);
+		else
+			fsnotify_create(d_inode(dparent), target.dentry);
+		break;
+	case 'M':
+		fsnotify_dentry(target.dentry, FS_MODIFY);
+		if (d_is_reg(target.dentry))
+			fsnotify_dentry(target.dentry, FS_CLOSE_WRITE);
+		break;
+	case 'A':
+		fsnotify_dentry(target.dentry, FS_ATTRIB);
+		break;
+	default:
+		err = -EINVAL;
+	}
+	dput(dparent);
+	path_put(&target);
+	return err;
+}
+
+/* Whether anything watches the filesystem `path` is on: without a watcher
+ * there is no one to tell, and a batch costs no lookups (a container
+ * writing many files to a bind mount sends its own changes back). */
+static bool kiri_watched(const char *path)
+{
+	struct path p;
+	bool watched;
+
+	if (kern_path(path, LOOKUP_FOLLOW, &p))
+		return true;
+	watched = fsnotify_sb_has_watchers(p.dentry->d_sb);
+	path_put(&p);
+	return watched;
+}
+
+static ssize_t kiri_write(struct file *file, const char __user *ubuf,
+			  size_t count, loff_t *ppos)
+{
+	char *buf, *line, *next;
+	int err = 0;
+
+	if (current->nsproxy->mnt_ns != init_task.nsproxy->mnt_ns)
+		return -EPERM;
+	if (count == 0 || count > PATH_MAX + 4)
+		return -EINVAL;
+	buf = memdup_user_nul(ubuf, count);
+	if (IS_ERR(buf))
+		return PTR_ERR(buf);
+	if (!kiri_watched("/mnt/mac")) {
+		kfree(buf);
+		return count;
+	}
+	for (line = buf; line && *line; line = next) {
+		next = strchr(line, '\n');
+		if (next)
+			*next++ = '\0';
+		if (!line[0])
+			continue;
+		if (line[1] != '\t' || !line[2]) {
+			err = -EINVAL;
+			continue;
+		}
+		err = kiri_event(line[0], line + 2);
+	}
+	kfree(buf);
+	return err ? err : count;
+}
+
+static const struct proc_ops kiri_fsnotify_ops = {
+	.proc_write = kiri_write,
+	.proc_lseek = noop_llseek,
+};
+
+static int __init kiri_fsnotify_init(void)
+{
+	proc_create("kiri-fsnotify", 0200, NULL, &kiri_fsnotify_ops);
+	return 0;
+}
+fs_initcall(kiri_fsnotify_init);
